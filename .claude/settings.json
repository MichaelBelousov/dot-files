{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(bun:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(zig:*)",
      "Bash(cargo:*)"
    ],
    "deny": [
      "Bash(rm:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r .message | xargs notify-send 'claude stopped' {}"
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "awaySummaryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true
}
